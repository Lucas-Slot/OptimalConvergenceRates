/-
  OptimalConvergenceRates/QuarticConvergence/Sphere/Kernel/FiniteNormalization.lean

  Normalization and approximation identities for finite positive zonal kernels.
-/
import OptimalConvergenceRates.QuarticConvergence.Sphere.Kernel.FiniteOperator
import OptimalConvergenceRates.QuarticConvergence.Sphere.FiniteDegree
import OptimalConvergenceRates.QuarticConvergence.Sphere.SphereIdeal

open MvPolynomial Finset

noncomputable section

namespace OptimalConvergenceRates
namespace QuarticConvergence

open SphereBallTransfers

/-- A finite quadrature kernel is normalized when its weighted mass is one at
every point of the algebraic unit sphere. -/
def FiniteZonalKernelNormalized {n N : ℕ}
    (p k : ℕ) (w : Fin N → ℝ) (y : Fin N → Fin n → ℝ) : Prop :=
  ∀ x ∈ sphereSet n,
    ∑ i, w i *
      ((sphereDirichletPolynomial k).eval (∑ j, y i j * x j)) ^ (2 * p) = 1

/-- A normalized finite kernel reproduces the constant function one on the
sphere. -/
theorem eval_finiteZonalKernelOperator_one {n N : ℕ}
    (p k : ℕ) (w : Fin N → ℝ) (y : Fin N → Fin n → ℝ)
    (h : FiniteZonalKernelNormalized p k w y)
    (x : Fin n → ℝ) (hx : x ∈ sphereSet n) :
    MvPolynomial.eval x
      (finiteZonalKernelOperator p k w y (1 : Fin N → ℝ)) = 1 := by
  rw [eval_finiteZonalKernelOperator]
  simpa using h x hx

/-- Normalization is equivalently the statement that the finite kernel sends one
to the constant-one polynomial function on the sphere. -/
theorem finiteZonalKernelNormalized_iff_restriction {n N : ℕ}
    (p k : ℕ) (w : Fin N → ℝ) (y : Fin N → Fin n → ℝ) :
    FiniteZonalKernelNormalized p k w y ↔
      sphereRestrictionLinear n
          (finiteZonalKernelOperator p k w y (1 : Fin N → ℝ)) =
        sphereRestrictionLinear n (1 : MvPolynomial (Fin n) ℝ) := by
  rw [sphereRestrictionLinear_eq_iff]
  constructor
  · intro h x hx
    rw [eval_finiteZonalKernelOperator]
    simpa using h x hx
  · intro h x hx
    have hx' := h x hx
    rw [eval_finiteZonalKernelOperator] at hx'
    simpa using hx'

/-- Literal polynomial reproduction of one is sufficient for finite-kernel
normalization. -/
theorem finiteZonalKernelNormalized_of_polynomial_eq {n N : ℕ}
    (p k : ℕ) (w : Fin N → ℝ) (y : Fin N → Fin n → ℝ)
    (hpoly : finiteZonalKernelOperator p k w y (1 : Fin N → ℝ) =
      (1 : MvPolynomial (Fin n) ℝ)) :
    FiniteZonalKernelNormalized p k w y := by
  apply (finiteZonalKernelNormalized_iff_restriction p k w y).2
  rw [hpoly]

/-- It is enough to reproduce one modulo the defining equation of the sphere,
which is the form naturally produced by moment computations. -/
theorem finiteZonalKernelNormalized_of_relation {n N : ℕ}
    (p k : ℕ) (w : Fin N → ℝ) (y : Fin N → Fin n → ℝ)
    (hpoly : ∃ a : MvPolynomial (Fin n) ℝ,
      finiteZonalKernelOperator p k w y (1 : Fin N → ℝ) =
        1 + sphereRelation n * a) :
    FiniteZonalKernelNormalized p k w y := by
  obtain ⟨a, ha⟩ := hpoly
  apply (finiteZonalKernelNormalized_iff_restriction p k w y).2
  rw [ha]
  simp

/-- In positive dimension, normalization is exactly reproduction of one modulo
the principal ideal generated by the sphere equation. -/
theorem finiteZonalKernelNormalized_iff_exists_relation {n N : ℕ}
    (hn : 0 < n) (p k : ℕ) (w : Fin N → ℝ) (y : Fin N → Fin n → ℝ) :
    FiniteZonalKernelNormalized p k w y ↔
      ∃ a : MvPolynomial (Fin n) ℝ,
        finiteZonalKernelOperator p k w y (1 : Fin N → ℝ) =
          1 + sphereRelation n * a := by
  constructor
  · intro h
    cases n with
    | zero => omega
    | succ m =>
        let P :=
          finiteZonalKernelOperator p k w y (1 : Fin N → ℝ) -
            (1 : MvPolynomial (Fin (m + 1)) ℝ)
        have hP : ∀ x ∈ sphereSet (m + 1), MvPolynomial.eval x P = 0 := by
          intro x hx
          dsimp only [P]
          rw [map_sub, eval_finiteZonalKernelOperator_one p k w y h x hx]
          simp
        obtain ⟨a, ha⟩ := sphere_vanishing_dvd_relation m P hP
        refine ⟨a, ?_⟩
        dsimp only [P] at ha
        calc
          finiteZonalKernelOperator p k w y (1 : Fin N → ℝ) =
              (finiteZonalKernelOperator p k w y (1 : Fin N → ℝ) - 1) + 1 := by
                ring
          _ = sphereRelation (m + 1) * a + 1 := by rw [ha]
          _ = 1 + sphereRelation (m + 1) * a := by ring
  · rintro ⟨a, ha⟩
    exact finiteZonalKernelNormalized_of_relation p k w y ⟨a, ha⟩

/-- The approximation error of a normalized finite kernel is the weighted
average of increments from the base point to the quadrature nodes. -/
theorem eval_finiteZonalKernelImage_sub {n N : ℕ}
    (p k : ℕ) (w : Fin N → ℝ) (y : Fin N → Fin n → ℝ)
    (v : (Fin n → ℝ) → ℝ)
    (h : FiniteZonalKernelNormalized p k w y)
    (x : Fin n → ℝ) (hx : x ∈ sphereSet n) :
    MvPolynomial.eval x (finiteZonalKernelImage p k w y v) - v x =
      ∑ i, w i * (v (y i) - v x) *
        ((sphereDirichletPolynomial k).eval (∑ j, y i j * x j)) ^ (2 * p) := by
  rw [eval_finiteZonalKernelImage]
  have hn := h x hx
  calc
    (∑ i, (w i * v (y i)) *
        ((sphereDirichletPolynomial k).eval (∑ j, y i j * x j)) ^ (2 * p)) - v x =
      (∑ i, (w i * v (y i)) *
        ((sphereDirichletPolynomial k).eval (∑ j, y i j * x j)) ^ (2 * p)) -
        v x * (∑ i, w i *
          ((sphereDirichletPolynomial k).eval (∑ j, y i j * x j)) ^ (2 * p)) := by
            rw [hn]
            ring
    _ = ∑ i, w i * (v (y i) - v x) *
        ((sphereDirichletPolynomial k).eval (∑ j, y i j * x j)) ^ (2 * p) := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro i _
      ring

/-- If all sampled increments are bounded by epsilon, a normalized positive
kernel has pointwise approximation error at most epsilon. -/
theorem abs_eval_finiteZonalKernelImage_sub_le {n N : ℕ}
    (p k : ℕ) (w : Fin N → ℝ) (y : Fin N → Fin n → ℝ)
    (v : (Fin n → ℝ) → ℝ) (ε : ℝ)
    (hw : ∀ i, 0 ≤ w i)
    (h : FiniteZonalKernelNormalized p k w y)
    (x : Fin n → ℝ) (hx : x ∈ sphereSet n)
    (hv : ∀ i, |v (y i) - v x| ≤ ε) :
    |MvPolynomial.eval x (finiteZonalKernelImage p k w y v) - v x| ≤ ε := by
  rw [eval_finiteZonalKernelImage_sub p k w y v h x hx]
  calc
    |∑ i, w i * (v (y i) - v x) *
        ((sphereDirichletPolynomial k).eval (∑ j, y i j * x j)) ^ (2 * p)| ≤
      ∑ i, |w i * (v (y i) - v x) *
        ((sphereDirichletPolynomial k).eval (∑ j, y i j * x j)) ^ (2 * p)| :=
          abs_sum_le_sum_abs _ _
    _ ≤ ∑ i, w i * ε *
        ((sphereDirichletPolynomial k).eval (∑ j, y i j * x j)) ^ (2 * p) := by
      apply Finset.sum_le_sum
      intro i _
      have hk :
          0 ≤ ((sphereDirichletPolynomial k).eval
            (∑ j, y i j * x j)) ^ (2 * p) := by
        rw [show 2 * p = p * 2 by omega, pow_mul]
        exact sq_nonneg _
      rw [abs_mul, abs_mul, abs_of_nonneg (hw i), abs_of_nonneg hk]
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (hv i) (hw i)) hk
    _ = ε * (∑ i, w i *
        ((sphereDirichletPolynomial k).eval (∑ j, y i j * x j)) ^ (2 * p)) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ = ε := by rw [h x hx, mul_one]

/-- The pointwise increment estimate upgrades to the repository's sphere
restriction seminorm. -/
theorem sphereSupNorm_finiteZonalKernelImage_sub_le {n N : ℕ}
    (hn : 0 < n) (p k : ℕ) (w : Fin N → ℝ) (y : Fin N → Fin n → ℝ)
    (f : MvPolynomial (Fin n) ℝ) (ε : ℝ)
    (hw : ∀ i, 0 ≤ w i)
    (h : FiniteZonalKernelNormalized p k w y)
    (hinc : ∀ x ∈ sphereSet n, ∀ i,
      |MvPolynomial.eval (y i) f - MvPolynomial.eval x f| ≤ ε) :
    sphereSupNorm
      (finiteZonalKernelImage p k w y (fun z ↦ MvPolynomial.eval z f) - f) ≤ ε := by
  apply sphereSupNorm_le_of_bound hn
  intro x hx
  rw [map_sub]
  exact abs_eval_finiteZonalKernelImage_sub_le p k w y
    (fun z ↦ MvPolynomial.eval z f) ε hw h x hx (hinc x hx)

end QuarticConvergence
end OptimalConvergenceRates


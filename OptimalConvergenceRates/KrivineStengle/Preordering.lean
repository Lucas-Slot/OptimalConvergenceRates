/-
  OptimalConvergenceRates/KrivineStengle/Preordering.lean

  Untruncated finite preordering certificates and their elementary calculus.
-/
import OptimalConvergenceRates.KrivineStengle.Defs

open MvPolynomial Finset

noncomputable section

namespace OptimalConvergenceRates.KrivineStengle

variable {n m : ℕ}

/-- All subsets of the finite generator index type. -/
private def allSubsets (m : ℕ) : Finset (Finset (Fin m)) :=
  (Finset.univ : Finset (Fin m)).powerset

/-- The squarefree generator product attached to a subset. -/
def generatorProduct (g : Fin m → MvPolynomial (Fin n) ℝ) (I : Finset (Fin m)) :
    MvPolynomial (Fin n) ℝ :=
  ∏ i ∈ I, g i

/-- An explicit finite representation of an element of the preordering generated by `g`. -/
def PreorderingRep (g : Fin m → MvPolynomial (Fin n) ℝ)
    (p : MvPolynomial (Fin n) ℝ) : Prop :=
  ∃ sigma : Finset (Fin m) → MvPolynomial (Fin n) ℝ,
    (∀ I, IsSOS (sigma I)) ∧
      p = ∑ I ∈ allSubsets m, sigma I * generatorProduct g I

/-- An explicit representation has a finite degree and hence belongs to a truncation. -/
theorem PreorderingRep.toPreorderingMem {g : Fin m → MvPolynomial (Fin n) ℝ}
    {p : MvPolynomial (Fin n) ℝ} (h : PreorderingRep g p) : PreorderingMem g p := by
  obtain ⟨sigma, hsigma, hsum⟩ := h
  let r := Finset.univ.sup fun I : Finset (Fin m) =>
    (sigma I * generatorProduct g I).totalDegree
  refine ⟨r, sigma, hsigma, ?_, hsum⟩
  intro I
  exact Finset.le_sup (f := fun J : Finset (Fin m) =>
    (sigma J * generatorProduct g J).totalDegree) (Finset.mem_univ I)

/-- Truncated preordering membership exposes an explicit finite representation. -/
theorem PreorderingMem.toRep {g : Fin m → MvPolynomial (Fin n) ℝ}
    {p : MvPolynomial (Fin n) ℝ} (h : PreorderingMem g p) : PreorderingRep g p := by
  obtain ⟨r, σ, hσ, -, hsum⟩ := h
  exact ⟨σ, hσ, hsum⟩

theorem preorderingMem_iff_rep {g : Fin m → MvPolynomial (Fin n) ℝ}
    {p : MvPolynomial (Fin n) ℝ} :
    PreorderingMem g p ↔ PreorderingRep g p :=
  ⟨PreorderingMem.toRep, PreorderingRep.toPreorderingMem⟩

theorem preorderingMem_zero (g : Fin m → MvPolynomial (Fin n) ℝ) :
    PreorderingMem g 0 := by
  apply PreorderingRep.toPreorderingMem
  refine ⟨0, fun _ ↦ IsSOS_zero, ?_⟩
  simp

theorem preorderingMem_one (g : Fin m → MvPolynomial (Fin n) ℝ) :
    PreorderingMem g 1 := by
  apply PreorderingRep.toPreorderingMem
  refine ⟨Function.update 0 ∅ 1, ?_, ?_⟩
  · intro I
    by_cases hI : I = ∅
    · subst hI
      rw [Function.update_self]
      simpa using IsSOS_sq (1 : MvPolynomial (Fin n) ℝ)
    · rw [Function.update_of_ne hI, Pi.zero_apply]
      exact IsSOS_zero
  · rw [Finset.sum_eq_single ∅]
    · simp [generatorProduct]
    · intro I _ hI
      simp [Function.update_of_ne hI]
    · simp [allSubsets]

theorem preorderingMem_sq (g : Fin m → MvPolynomial (Fin n) ℝ)
    (q : MvPolynomial (Fin n) ℝ) : PreorderingMem g (q ^ 2) := by
  apply PreorderingRep.toPreorderingMem
  refine ⟨Function.update 0 ∅ (q ^ 2), ?_, ?_⟩
  · intro I
    by_cases hI : I = ∅
    · subst hI
      rw [Function.update_self]
      exact IsSOS_sq q
    · rw [Function.update_of_ne hI, Pi.zero_apply]
      exact IsSOS_zero
  · rw [Finset.sum_eq_single ∅]
    · simp [generatorProduct]
    · intro I _ hI
      simp [Function.update_of_ne hI]
    · simp [allSubsets]

theorem preorderingMem_generator (g : Fin m → MvPolynomial (Fin n) ℝ) (i : Fin m) :
    PreorderingMem g (g i) := by
  apply PreorderingRep.toPreorderingMem
  refine ⟨Function.update 0 {i} 1, ?_, ?_⟩
  · intro I
    by_cases hI : I = {i}
    · subst hI
      rw [Function.update_self]
      simpa using IsSOS_sq (1 : MvPolynomial (Fin n) ℝ)
    · rw [Function.update_of_ne hI, Pi.zero_apply]
      exact IsSOS_zero
  · rw [Finset.sum_eq_single {i}]
    · simp [generatorProduct]
    · intro I _ hI
      simp [Function.update_of_ne hI]
    · simp [allSubsets]

theorem preorderingMem_add {g : Fin m → MvPolynomial (Fin n) ℝ}
    {p q : MvPolynomial (Fin n) ℝ} (hp : PreorderingMem g p) (hq : PreorderingMem g q) :
    PreorderingMem g (p + q) := by
  obtain ⟨σ, hσ, hp⟩ := hp.toRep
  obtain ⟨τ, hτ, hq⟩ := hq.toRep
  apply PreorderingRep.toPreorderingMem
  refine ⟨fun I ↦ σ I + τ I, fun I ↦ IsSOS_add (hσ I) (hτ I), ?_⟩
  rw [hp, hq, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro I _
  ring

/-- The subset carrying the odd generator multiplicities in a product of two terms. -/
def subsetParity (I J : Finset (Fin m)) : Finset (Fin m) :=
  (I \ J) ∪ (J \ I)

theorem subsetParity_mem_allSubsets (I J : Finset (Fin m)) :
    subsetParity I J ∈ allSubsets m := by
  simp [subsetParity, allSubsets]

/-- Multiplying squarefree generator products absorbs their common part into a square. -/
theorem generatorProduct_mul (g : Fin m → MvPolynomial (Fin n) ℝ)
    (I J : Finset (Fin m)) :
    generatorProduct g I * generatorProduct g J =
      (∏ i ∈ I ∩ J, g i) ^ 2 * generatorProduct g (subsetParity I J) := by
  classical
  have hI :
      (∏ i ∈ I \ J, g i) * (∏ i ∈ I ∩ J, g i) = ∏ i ∈ I, g i := by
    have h := Finset.prod_sdiff (f := g) (Finset.inter_subset_left : I ∩ J ⊆ I)
    have heq : I \ (I ∩ J) = I \ J := by
      ext i
      simp
    rwa [heq] at h
  have hJ :
      (∏ i ∈ J \ I, g i) * (∏ i ∈ I ∩ J, g i) = ∏ i ∈ J, g i := by
    have h := Finset.prod_sdiff (f := g) (Finset.inter_subset_right : I ∩ J ⊆ J)
    have heq : J \ (I ∩ J) = J \ I := by
      ext i
      simp
    rwa [heq] at h
  have hdisjoint : Disjoint (I \ J) (J \ I) := by
    rw [Finset.disjoint_left]
    intro i hi hji
    exact (Finset.mem_sdiff.mp hi).2 (Finset.mem_sdiff.mp hji).1
  have hunion :
      generatorProduct g (subsetParity I J) =
        (∏ i ∈ I \ J, g i) * ∏ i ∈ J \ I, g i := by
    exact Finset.prod_union hdisjoint
  rw [generatorProduct, generatorProduct, ← hI, ← hJ, hunion]
  ring

/-- The SOS coefficient obtained by grouping pairs of terms with the same parity subset. -/
def productCoefficient (g : Fin m → MvPolynomial (Fin n) ℝ)
    (σ τ : Finset (Fin m) → MvPolynomial (Fin n) ℝ) (K : Finset (Fin m)) :
    MvPolynomial (Fin n) ℝ :=
  let pairs := (allSubsets m).product (allSubsets m)
  ∑ IJ ∈ pairs.filter (fun IJ ↦ subsetParity IJ.1 IJ.2 = K),
    (σ IJ.1 * τ IJ.2) * (∏ i ∈ IJ.1 ∩ IJ.2, g i) ^ 2

theorem productCoefficient_isSOS (g : Fin m → MvPolynomial (Fin n) ℝ)
    (σ τ : Finset (Fin m) → MvPolynomial (Fin n) ℝ)
    (hσ : ∀ I, IsSOS (σ I)) (hτ : ∀ I, IsSOS (τ I)) (K : Finset (Fin m)) :
    IsSOS (productCoefficient g σ τ K) := by
  classical
  apply IsSOS_sum_finset
  intro IJ _
  exact IsSOS_mul (IsSOS_mul (hσ IJ.1) (hτ IJ.2))
    (IsSOS_sq (∏ i ∈ IJ.1 ∩ IJ.2, g i))

theorem productCoefficient_sum (g : Fin m → MvPolynomial (Fin n) ℝ)
    (σ τ : Finset (Fin m) → MvPolynomial (Fin n) ℝ) :
    (∑ I ∈ allSubsets m, σ I * generatorProduct g I) *
        (∑ J ∈ allSubsets m, τ J * generatorProduct g J) =
      ∑ K ∈ allSubsets m, productCoefficient g σ τ K * generatorProduct g K := by
  classical
  let pairs := (allSubsets m).product (allSubsets m)
  let parity : Finset (Fin m) × Finset (Fin m) → Finset (Fin m) :=
    fun IJ ↦ subsetParity IJ.1 IJ.2
  let term : Finset (Fin m) × Finset (Fin m) → MvPolynomial (Fin n) ℝ :=
    fun IJ ↦ (σ IJ.1 * τ IJ.2) * (∏ i ∈ IJ.1 ∩ IJ.2, g i) ^ 2 *
      generatorProduct g (parity IJ)
  have hmaps : ∀ IJ ∈ pairs, parity IJ ∈ allSubsets m := by
    intro IJ _
    exact subsetParity_mem_allSubsets IJ.1 IJ.2
  have hfiber :
      ∑ K ∈ allSubsets m,
          ∑ IJ ∈ pairs.filter (fun IJ ↦ parity IJ = K), term IJ =
        ∑ IJ ∈ pairs, term IJ :=
    Finset.sum_fiberwise_of_maps_to hmaps term
  calc
    (∑ I ∈ allSubsets m, σ I * generatorProduct g I) *
        (∑ J ∈ allSubsets m, τ J * generatorProduct g J) =
        ∑ IJ ∈ pairs,
          (σ IJ.1 * generatorProduct g IJ.1) *
            (τ IJ.2 * generatorProduct g IJ.2) := by
      simp only [pairs]
      rw [Finset.sum_mul]
      simp_rw [Finset.mul_sum]
      exact (Finset.sum_product (allSubsets m) (allSubsets m)
        (fun IJ ↦ (σ IJ.1 * generatorProduct g IJ.1) *
          (τ IJ.2 * generatorProduct g IJ.2))).symm
    _ = ∑ IJ ∈ pairs, term IJ := by
      apply Finset.sum_congr rfl
      intro IJ _
      simp only [term, parity]
      rw [show
        σ IJ.1 * generatorProduct g IJ.1 * (τ IJ.2 * generatorProduct g IJ.2) =
          (σ IJ.1 * τ IJ.2) *
            (generatorProduct g IJ.1 * generatorProduct g IJ.2) by ring]
      rw [generatorProduct_mul]
      ring
    _ = ∑ K ∈ allSubsets m,
        productCoefficient g σ τ K * generatorProduct g K := by
      rw [← hfiber]
      apply Finset.sum_congr rfl
      intro K _
      simp only [productCoefficient, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro IJ hIJ
      have hparity : parity IJ = K := (Finset.mem_filter.mp hIJ).2
      simp only [term]
      rw [hparity]

theorem preorderingMem_mul {g : Fin m → MvPolynomial (Fin n) ℝ}
    {p q : MvPolynomial (Fin n) ℝ} (hp : PreorderingMem g p) (hq : PreorderingMem g q) :
    PreorderingMem g (p * q) := by
  obtain ⟨σ, hσ, hp⟩ := hp.toRep
  obtain ⟨τ, hτ, hq⟩ := hq.toRep
  apply PreorderingRep.toPreorderingMem
  refine ⟨productCoefficient g σ τ, productCoefficient_isSOS g σ τ hσ hτ, ?_⟩
  rw [hp, hq, productCoefficient_sum]

/-- An SOS polynomial maps to a nonnegative element of an ordered field. -/
private theorem IsSOS.map_nonneg {F : Type*} [Field F] [LinearOrder F] [IsStrictOrderedRing F]
    {q : MvPolynomial (Fin n) ℝ} (hq : IsSOS q)
    (φ : MvPolynomial (Fin n) ℝ →+* F) : 0 ≤ φ q := by
  obtain ⟨N, Q, rfl⟩ := hq
  simp only [map_sum, map_pow]
  exact Finset.sum_nonneg fun i _ ↦ sq_nonneg (φ (Q i))

/-- Every preordering element is nonnegative under a homomorphism that makes the generators
nonnegative. -/
theorem PreorderingMem.map_nonneg {F : Type*} [Field F] [LinearOrder F]
    [IsStrictOrderedRing F]
    {g : Fin m → MvPolynomial (Fin n) ℝ} {p : MvPolynomial (Fin n) ℝ}
    (hp : PreorderingMem g p) (φ : MvPolynomial (Fin n) ℝ →+* F)
    (hg : ∀ i, 0 ≤ φ (g i)) : 0 ≤ φ p := by
  obtain ⟨σ, hσ, hp⟩ := hp.toRep
  rw [hp, map_sum]
  apply Finset.sum_nonneg
  intro I _
  rw [map_mul]
  apply mul_nonneg (IsSOS.map_nonneg (hσ I) φ)
  simp only [generatorProduct, map_prod]
  exact Finset.prod_nonneg fun i _ ↦ hg i

/-- Every preordering element is nonnegative on the generated basic closed set. -/
theorem PreorderingMem.nonnegOn {g : Fin m → MvPolynomial (Fin n) ℝ}
    {p : MvPolynomial (Fin n) ℝ} (hp : PreorderingMem g p) :
    IsNonnegOn p (basicClosedSet g) := by
  intro x hx
  exact hp.map_nonneg (MvPolynomial.eval₂Hom (RingHom.id ℝ) x) hx

end OptimalConvergenceRates.KrivineStengle

end

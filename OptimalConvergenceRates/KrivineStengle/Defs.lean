/-
  OptimalConvergenceRates/KrivineStengle/Defs.lean

  Public data used by the nonnegative Krivine--Stengle theorem.
-/
import OptimalConvergenceRates.BasicNotions.GeneralCones

open MvPolynomial

noncomputable section

namespace OptimalConvergenceRates.KrivineStengle

variable {n m : ℕ}

/-- Membership in the untruncated preordering generated by `g`. -/
def PreorderingMem (g : Fin m → MvPolynomial (Fin n) ℝ)
    (p : MvPolynomial (Fin n) ℝ) : Prop :=
  ∃ r, p ∈ GenPreordering g r

/-- The basic closed semialgebraic set cut out by the inequalities `g i ≥ 0`. -/
def basicClosedSet (g : Fin m → MvPolynomial (Fin n) ℝ) : Set (Fin n → ℝ) :=
  {x | ∀ i, 0 ≤ MvPolynomial.eval x (g i)}

/-- A finite witness for the nonnegative Krivine--Stengle identity. -/
structure KSWitness (g : Fin m → MvPolynomial (Fin n) ℝ)
    (p : MvPolynomial (Fin n) ℝ) where
  k : ℕ
  k_pos : 1 ≤ k
  S : MvPolynomial (Fin n) ℝ
  T : MvPolynomial (Fin n) ℝ
  hS : PreorderingMem g S
  hT : PreorderingMem g T
  identity : p * S = p ^ (2 * k) + T

/-- The forward nonnegative Krivine--Stengle statement, recorded before its proof. -/
def NonnegativeKrivineStengleStatement : Prop :=
  ∀ {n m : ℕ} (g : Fin m → MvPolynomial (Fin n) ℝ)
    (p : MvPolynomial (Fin n) ℝ),
    IsNonnegOn p (basicClosedSet g) → Nonempty (KSWitness g p)

/-- The equivalence form of the nonnegative Krivine--Stengle statement. -/
def NonnegativeKrivineStengleIffStatement : Prop :=
  ∀ {n m : ℕ} (g : Fin m → MvPolynomial (Fin n) ℝ)
    (p : MvPolynomial (Fin n) ℝ),
    IsNonnegOn p (basicClosedSet g) ↔ Nonempty (KSWitness g p)

end OptimalConvergenceRates.KrivineStengle

end

/-
  OptimalConvergenceRates/GeneralArchimedean/Defs.lean

  Shared definitions for general Archimedean polynomial optimization.
-/
import OptimalConvergenceRates.BasicNotions.GeneralConeOps
import OptimalConvergenceRates.KrivineStengle.Defs
import Mathlib.Analysis.SpecialFunctions.Log.Basic

noncomputable section

open MvPolynomial

namespace OptimalConvergenceRates.GeneralArchimedean

variable {n m : ℕ}

/-- Untruncated membership in the quadratic module generated by `g`. -/
def QuadraticModuleMem (g : Fin m → MvPolynomial (Fin n) ℝ)
    (p : MvPolynomial (Fin n) ℝ) : Prop :=
  ∃ r, p ∈ GenQuadraticModule g r

/-- Archimedeanity in the ball-certificate form used by the quantitative proof. -/
def IsArchimedean (g : Fin m → MvPolynomial (Fin n) ℝ) : Prop :=
  ∃ R r, 0 < R ∧
    C R - ∑ i : Fin n, X i ^ 2 ∈ GenQuadraticModule g r

/-- The safe natural-number version of `(log r)^4 / r^2`. -/
def logFourOverSq (r : ℕ) : ℝ :=
  Real.log ((max r 2 : ℕ) : ℝ) ^ 4 / (r : ℝ) ^ 2

/-- The minimum value of `f` on the basic closed set generated by `g`. -/
noncomputable def polynomialMinimum (g : Fin m → MvPolynomial (Fin n) ℝ)
    (f : MvPolynomial (Fin n) ℝ) : ℝ :=
  sInf ((fun x ↦ MvPolynomial.eval x f) '' KrivineStengle.basicClosedSet g)

open Classical in
/-- The generalized quadratic-module Lasserre lower bound. -/
noncomputable def genLasserreBoundQM (g : Fin m → MvPolynomial (Fin n) ℝ)
    (f : MvPolynomial (Fin n) ℝ) (r : ℕ) : WithBot ℝ :=
  if _h : {l : ℝ | f - C l ∈ GenQuadraticModule g r}.Nonempty then
    ↑(sSup {l : ℝ | f - C l ∈ GenQuadraticModule g r})
  else
    ⊥

end OptimalConvergenceRates.GeneralArchimedean

end

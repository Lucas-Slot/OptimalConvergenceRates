import OptimalConvergenceRates.CQC.TransferAbsorption
import OptimalConvergenceRates.GeneralArchimedean.GeneralLasserre
import Mathlib.Analysis.SpecialFunctions.Pow.Asymptotics

/-! # Preservation of arbitrary positive Putinar power exponents -/

noncomputable section
open MvPolynomial
namespace OptimalConvergenceRates.CQCInternal
open GeneralArchimedean

/-- A fixed polynomial has a box-Putinar order bound
`O(ε⁻¹ᐟᵅ)` as `ε ↓ 0`. -/
def HasBoxPutinarPowerRate {k : ℕ} (α : ℝ)
    (P : MvPolynomial (Fin k) ℝ) : Prop :=
  ∃ B ε₀ : ℝ, 0 < B ∧ 0 < ε₀ ∧
    ∀ ε : ℝ, 0 < ε → ε ≤ ε₀ →
      ∃ r : ℕ,
        (r : ℝ) ≤ B * (1 / ε) ^ (1 / α) ∧
        P + C ε ∈ BoxQuadraticModule k r

/-- A fixed polynomial has the analogous generalized quadratic-module order
bound on the basic closed set generated by `g`. -/
def HasCQCPutinarPowerRate {n m : ℕ} (α : ℝ)
    (g : Fin m → MvPolynomial (Fin n) ℝ)
    (p : MvPolynomial (Fin n) ℝ) : Prop :=
  ∃ B ε₀ : ℝ, 0 < B ∧ 0 < ε₀ ∧
    ∀ ε : ℝ, 0 < ε → ε ≤ ε₀ →
      ∃ r : ℕ,
        (r : ℝ) ≤ B * (1 / ε) ^ (1 / α) ∧
        p + C ε ∈ GenQuadraticModule g r

/-- Universal fixed-instance box-Putinar power rate in every positive
dimension. Constants may depend on the fixed polynomial and dimension. -/
def UnitBoxPutinarPowerRate (α : ℝ) : Prop :=
  ∀ {k : ℕ}, 0 < k → ∀ P : MvPolynomial (Fin k) ℝ,
    IsNonnegOn P (Hypercube k) → HasBoxPutinarPowerRate α P

/-- Universal fixed-instance power rate for Archimedean systems satisfying
CQC. Constants may depend on the fixed generator family and polynomial. -/
def ArchimedeanCQCPutinarPowerRate (α : ℝ) : Prop :=
  ∀ {n m : ℕ}, 0 < n → 0 < m →
    ∀ (g : Fin m → MvPolynomial (Fin n) ℝ)
      (p : MvPolynomial (Fin n) ℝ),
      (KrivineStengle.basicClosedSet g).Nonempty →
      IsArchimedean g →
      ActiveGradientIndependent g →
      IsNonnegOn p (KrivineStengle.basicClosedSet g) →
      HasCQCPutinarPowerRate α g p

theorem hasCQCPutinarPowerRate_of_box
    {n m : ℕ} {α : ℝ} (hα : 0 < α)
    (hn : 0 < n) (hm : 0 < m)
    (g : Fin m → MvPolynomial (Fin n) ℝ)
    (p : MvPolynomial (Fin n) ℝ)
    (hne : (KrivineStengle.basicClosedSet g).Nonempty)
    (harch : IsArchimedean g)
    (hcqc : ActiveGradientIndependent g)
    (hp : IsNonnegOn p (KrivineStengle.basicClosedSet g))
    (hbox : UnitBoxPutinarPowerRate α) :
    HasCQCPutinarPowerRate α g p := by
  obtain ⟨P, c, Clog, hc, hClog, hP, _hPdegree, _hPzero, htransfer⟩ :=
    fixedInstanceTransfer_internal hn hm hne harch hcqc hp
  obtain ⟨B, ε₀, hB, hε₀, hboxRate⟩ :=
    hbox (by omega : 0 < n + m) P hP
  let β : ℝ := 1 / α
  have hβ : 0 < β := by dsimp [β]; positivity
  have hcpos : 0 < c := zero_lt_one.trans_le hc
  let ε₁ : ℝ := min (1 / 2) (min 1 (c * ε₀))
  have hε₁ : 0 < ε₁ := by
    dsimp [ε₁]
    positivity
  let dg : ℝ := generatorDegree g
  have hdg : 0 < dg := by
    dsimp [dg]
    exact_mod_cast generatorDegree_pos g
  let B' : ℝ :=
    dg * B * c ^ β + Clog * (1 + 1 / β) + 1
  have hB' : 0 < B' := by
    dsimp [B']
    positivity
  refine ⟨B', ε₁, hB', hε₁, ?_⟩
  intro ε hε hεε₁
  have hεhalf : ε ≤ 1 / 2 :=
    hεε₁.trans (min_le_left _ _)
  have hεone : ε ≤ 1 :=
    hεε₁.trans (min_le_right _ _)
      |>.trans (min_le_left _ _)
  have hεscaled : ε ≤ c * ε₀ :=
    hεε₁.trans (min_le_right _ _)
      |>.trans (min_le_right _ _)
  let δ : ℝ := ε / c
  have hδ : 0 < δ := div_pos hε hcpos
  have hδε₀ : δ ≤ ε₀ := by
    dsimp [δ]
    exact (div_le_iff₀ hcpos).2 (by simpa [mul_comm] using hεscaled)
  obtain ⟨r, hr, hrCert⟩ := hboxRate δ hδ hδε₀
  let R : ℕ :=
    generatorDegree g * r +
      Nat.ceil (Clog * (1 + Real.log (1 / ε)))
  have hRCert : p + C ε ∈ GenQuadraticModule g R := by
    dsimp [R]
    exact htransfer hε hεhalf hrCert
  refine ⟨R, ?_, hRCert⟩
  let T : ℝ := 1 / ε
  have hTpos : 0 < T := one_div_pos.mpr hε
  have hTone : 1 ≤ T := by
    dsimp [T]
    exact (le_div_iff₀ hε).2 (by simpa using hεone)
  have hTβone : 1 ≤ T ^ β := Real.one_le_rpow hTone hβ.le
  have hlog : Real.log T ≤ T ^ β / β :=
    Real.log_le_rpow_div hTpos.le hβ
  have hδinv : 1 / δ = c * T := by
    dsimp [δ, T]
    field_simp
  have hr' : (r : ℝ) ≤ B * c ^ β * T ^ β := by
    rw [hδinv, Real.mul_rpow hcpos.le hTpos.le] at hr
    nlinarith
  let A : ℝ := Clog * (1 + Real.log T)
  have hA : 0 ≤ A := by
    dsimp [A]
    have hlog0 : 0 ≤ Real.log T := Real.log_nonneg hTone
    positivity
  have hceil : (Nat.ceil A : ℝ) ≤ A + 1 :=
    (Nat.ceil_lt_add_one hA).le
  have hRcast :
      (R : ℝ) ≤
        dg * (B * c ^ β * T ^ β) +
          Clog * (1 + T ^ β / β) + 1 := by
    dsimp [R, dg]
    push_cast
    dsimp [A] at hceil
    dsimp [T] at hceil ⊢
    nlinarith
  have hcoefficient :
      dg * (B * c ^ β * T ^ β) +
          Clog * (1 + T ^ β / β) + 1 ≤
        B' * T ^ β := by
    have htail :
        Clog * (1 + T ^ β / β) + 1 ≤
          Clog * (T ^ β + T ^ β / β) + T ^ β := by
      gcongr
    calc
      dg * (B * c ^ β * T ^ β) +
          Clog * (1 + T ^ β / β) + 1 ≤
          dg * (B * c ^ β * T ^ β) +
            (Clog * (T ^ β + T ^ β / β) + T ^ β) :=
        by simpa only [add_assoc] using
          add_le_add (le_refl (dg * (B * c ^ β * T ^ β))) htail
      _ = B' * T ^ β := by
        dsimp [B']
        ring
  simpa only [T, β] using hRcast.trans hcoefficient

theorem archimedeanCQCPutinarPowerRate_of_box
    {α : ℝ} (hα : 0 < α)
    (hbox : UnitBoxPutinarPowerRate α) :
    ArchimedeanCQCPutinarPowerRate α := by
  intro n m hn hm g p hne harch hcqc hp
  exact hasCQCPutinarPowerRate_of_box hα hn hm g p hne harch hcqc hp hbox

theorem basicClosedSet_boxSemialgebraicGenerator (k : ℕ) :
    KrivineStengle.basicClosedSet
      (fun i : Fin k ↦ BoxSemialgebraicGenerator i) =
        Hypercube k := by
  ext x
  constructor
  · intro hx
    rw [Hypercube_mem_iff]
    intro i
    have hi := hx i
    rw [BoxSemialgebraicGenerator_eval] at hi
    constructor <;> nlinarith [sq_nonneg (x i)]
  · intro hx i
    exact BoxSemialgebraicGenerator_nonneg_on_hypercube i x hx

theorem boxSemialgebraicGenerator_isArchimedean {k : ℕ} (hk : 0 < k) :
    IsArchimedean (fun i : Fin k ↦ BoxSemialgebraicGenerator i) := by
  refine ⟨k, 2, by exact_mod_cast hk, ?_⟩
  refine ⟨0, fun _ ↦ 1, IsSOS_zero, fun _ ↦ ⟨1, fun _ ↦ 1, by simp⟩, by simp, ?_, ?_⟩
  · intro i
    calc
      ((1 : MvPolynomial (Fin k) ℝ) *
          BoxSemialgebraicGenerator i).totalDegree =
          (BoxSemialgebraicGenerator i).totalDegree := by rw [one_mul]
      _ ≤ 2 := by
        unfold BoxSemialgebraicGenerator
        exact (MvPolynomial.totalDegree_sub _ _).trans (by simp)
  · simp only [zero_add, one_mul, BoxSemialgebraicGenerator]
    rw [Finset.sum_sub_distrib]
    simp

theorem pderiv_boxSemialgebraicGenerator (k : ℕ) (i j : Fin k) :
    pderiv j (BoxSemialgebraicGenerator i) =
      if j = i then -(2 * X i) else 0 := by
  classical
  unfold BoxSemialgebraicGenerator
  by_cases hji : j = i
  · subst j
    simp only [map_sub, pderiv_one, pderiv_pow, pderiv_X_self,
      if_pos, Nat.cast_ofNat, mul_one]
    ring
  · simp only [map_sub, pderiv_one, pderiv_pow,
      pderiv_X_of_ne (Ne.symm hji), if_neg hji, mul_zero, sub_zero]


theorem boxSemialgebraicGenerator_activeGradientIndependent (k : ℕ) :
    ActiveGradientIndependent
      (fun i : Fin k ↦ BoxSemialgebraicGenerator i) := by
  classical
  intro x hx
  rw [Fintype.linearIndependent_iff]
  intro a ha i
  have hxi : x i.1 ≠ 0 := by
    have hi := i.2
    rw [BoxSemialgebraicGenerator_eval] at hi
    intro hzero
    rw [hzero] at hi
    norm_num at hi
  have hi := congrFun ha i.1
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
    Pi.zero_apply] at hi
  simp only [pderiv_boxSemialgebraicGenerator] at hi
  have hi' :
      a i * MvPolynomial.eval x (-(2 * X i.1)) = 0 := by
    calc
      a i * MvPolynomial.eval x (-(2 * X i.1)) =
          ∑ j, a j * MvPolynomial.eval x
            (if i.1 = j.1 then -(2 * X j.1) else 0) := by
        symm
        rw [Finset.sum_eq_single i]
        · simp
        · intro j _ hji
          have hval : ¬i.1 = j.1 := by
            intro hij
            exact hji (Subtype.ext hij.symm)
          simp [hval]
        · simp
      _ = 0 := hi
  simp only [map_neg, map_mul, map_ofNat, eval_X] at hi'
  exact (mul_eq_zero.mp hi').resolve_right
    (neg_ne_zero.mpr (mul_ne_zero (by norm_num) hxi))


theorem boxPutinarPowerRate_of_archimedeanCQC {α : ℝ}
    (hCQC : ArchimedeanCQCPutinarPowerRate α) :
    UnitBoxPutinarPowerRate α := by
  intro k hk P hP
  let g : Fin k → MvPolynomial (Fin k) ℝ :=
    fun i ↦ BoxSemialgebraicGenerator i
  have hne : (KrivineStengle.basicClosedSet g).Nonempty := by
    rw [show KrivineStengle.basicClosedSet g = Hypercube k by
      exact basicClosedSet_boxSemialgebraicGenerator k]
    refine ⟨0, ?_⟩
    rw [Hypercube_mem_iff]
    simp
  have hP' : IsNonnegOn P (KrivineStengle.basicClosedSet g) := by
    simpa only [g, basicClosedSet_boxSemialgebraicGenerator] using hP
  have hrate := hCQC hk hk g P hne (boxSemialgebraicGenerator_isArchimedean hk)
    (boxSemialgebraicGenerator_activeGradientIndependent k) hP'
  simpa only [HasCQCPutinarPowerRate, HasBoxPutinarPowerRate,
    BoxQuadraticModule, GenQuadraticModule, g] using hrate


/-- For every positive real exponent, the universal fixed-instance box rate is
equivalent to the universal rate for Archimedean CQC systems. -/
theorem boxPutinarPowerRate_iff_archimedeanCQC
    {α : ℝ} (hα : 0 < α) :
    UnitBoxPutinarPowerRate α ↔ ArchimedeanCQCPutinarPowerRate α :=
  ⟨archimedeanCQCPutinarPowerRate_of_box hα,
    boxPutinarPowerRate_of_archimedeanCQC⟩

/-- Uniform centered certificates with error `A / r ^ α` imply the same
Lasserre hierarchy error bound. The proof uses only feasibility of the
displayed scalar, and therefore does not assume that the SDP supremum is
attained. -/
theorem lasserrePowerRate_of_centeredCertificates
    {n m : ℕ} {α A : ℝ}
    (g : Fin m → MvPolynomial (Fin n) ℝ)
    (f : MvPolynomial (Fin n) ℝ)
    (hne : (KrivineStengle.basicClosedSet g).Nonempty)
    (harch : IsArchimedean g)
    (r₀ : ℕ)
    (hcert : ∀ r, r₀ ≤ r →
      f - C (polynomialMinimum g f) + C (A / (r : ℝ) ^ α) ∈
        GenQuadraticModule g r) :
    ∀ r, r₀ ≤ r →
      ((polynomialMinimum g f - A / (r : ℝ) ^ α : ℝ) : WithBot ℝ) ≤
          genLasserreBoundQM g f r ∧
        genLasserreBoundQM g f r ≤
          (polynomialMinimum g f : WithBot ℝ) := by
  intro r hr
  exact
    ⟨genLasserreBoundQM_ge_of_centered_certificate hne harch f r (hcert r hr),
      genLasserreBoundQM_le_polynomialMinimum hne harch f r⟩


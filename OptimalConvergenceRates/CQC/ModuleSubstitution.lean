import OptimalConvergenceRates.GeneralArchimedean.ArchimedeanGeometry
import OptimalConvergenceRates.QuarticConvergence.PutinarCube.QuadraticModuleSubstitution

/-!
# Substitution of box certificates into arbitrary quadratic modules

The source cone is the canonical quadratic module of a cube. The target cone
may be generated by any finite polynomial family.
-/

noncomputable section

open MvPolynomial Finset

namespace OptimalConvergenceRates

variable {n k m d r s : ℕ}

/-- If every source cube generator has a fixed certificate in an arbitrary
target quadratic module, polynomial substitution transports a source
order-`r` certificate to target order `s + d * r`. -/
theorem aeval_mem_genQuadraticModule_of_box_generators
    (g : Fin m → MvPolynomial (Fin k) ℝ)
    (f : Fin n → MvPolynomial (Fin k) ℝ)
    (hfdegree : ∀ i, (f i).totalDegree ≤ d)
    (hgenerator : ∀ i,
      MvPolynomial.aeval f (BoxSemialgebraicGenerator i) ∈
        GenQuadraticModule g s)
    {p : MvPolynomial (Fin n) ℝ}
    (hp : p ∈ BoxQuadraticModule n r) :
    MvPolynomial.aeval f p ∈ GenQuadraticModule g (s + d * r) := by
  obtain ⟨σ₀, σ, hσ₀, hσ, hdegree₀, hdegree, rfl⟩ := hp
  have hmapDegree (q : MvPolynomial (Fin n) ℝ) (hq : q.totalDegree ≤ r) :
      (MvPolynomial.aeval f q).totalDegree ≤ d * r :=
    (QuarticConvergence.totalDegree_aeval_le_mul_general f hfdegree q).trans
      (Nat.mul_le_mul_left d hq)
  have hfree : MvPolynomial.aeval f σ₀ ∈ GenQuadraticModule g (s + d * r) :=
    genQuadraticModule_sos g
      (QuarticConvergence.isSOS_aeval hσ₀ f)
      ((hmapDegree σ₀ hdegree₀).trans (Nat.le_add_left _ _))
  have hterm (i : Fin n) :
      MvPolynomial.aeval f (σ i) *
          MvPolynomial.aeval f (BoxSemialgebraicGenerator i) ∈
        GenQuadraticModule g (s + d * r) := by
    have hσdegree : (σ i).totalDegree ≤ r :=
      QuarticConvergence.totalDegree_le_of_mul_boxSemialgebraicGenerator_totalDegree_le
        i (hdegree i)
    have hmappedDegree : (MvPolynomial.aeval f (σ i)).totalDegree ≤ d * r :=
      hmapDegree (σ i) hσdegree
    exact GenQuadraticModule_mono
      (Nat.add_le_add_left hmappedDegree s)
      (genQuadraticModule_sos_mul
        (QuarticConvergence.isSOS_aeval (hσ i) f) (hgenerator i))
  simpa only [map_add, map_sum, map_mul] using
    GenQuadraticModule_add hfree (genQuadraticModule_sum univ _ fun i _ ↦ hterm i)

end OptimalConvergenceRates

end

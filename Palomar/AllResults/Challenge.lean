namespace OptimalConvergenceRates

variable {n : ℕ}

/-! ## Common definitions -/

/-- A polynomial is a sum of finitely many polynomial squares. -/
def IsSOS (p : MvPolynomial (Fin n) ℝ) : Prop :=
  ∃ (m : ℕ) (q : Fin m → MvPolynomial (Fin n) ℝ),
    p = ∑ i : Fin m, (q i) ^ 2

/-- A polynomial is nonnegative at every point of a set. -/
def IsNonnegOn (p : MvPolynomial (Fin n) ℝ) (S : Set (Fin n → ℝ)) : Prop :=
  ∀ x ∈ S, 0 ≤ MvPolynomial.eval x p

/-- The unit hypercube `[-1,1]^n`. -/
def Hypercube (n : ℕ) : Set (Fin n → ℝ) :=
  Set.pi Set.univ (fun _ ↦ Set.Icc (-1) 1)

/-- The supremum norm of a polynomial on the unit hypercube. -/
noncomputable def polySupNorm (f : MvPolynomial (Fin n) ℝ) : ℝ :=
  sSup ((fun x ↦ |MvPolynomial.eval x f|) '' Hypercube n)

/-- The box generator `1 - x_i^2` for coordinate `i`. -/
def BoxSemialgebraicGenerator (i : Fin n) : MvPolynomial (Fin n) ℝ :=
  1 - X i ^ 2

/-- The product of the box generators indexed by `J`. -/
def BoxSemialgebraicGeneratorProd (J : Finset (Fin n)) : MvPolynomial (Fin n) ℝ :=
  ∏ j ∈ J, BoxSemialgebraicGenerator j

/-- The box preordering truncated by total degree `r` of each weighted term. -/
def BoxPreordering (n : ℕ) (r : ℕ) : Set (MvPolynomial (Fin n) ℝ) :=
  { p | ∃ (σ : Finset (Fin n) → MvPolynomial (Fin n) ℝ),
    (∀ J, IsSOS (σ J)) ∧
    (∀ J, (σ J * BoxSemialgebraicGeneratorProd J).totalDegree ≤ r) ∧
    p = ∑ J ∈ Finset.univ.powerset, σ J * BoxSemialgebraicGeneratorProd J }

/-- The box quadratic module truncated by total degree `r` of each weighted term. -/
def BoxQuadraticModule (n : ℕ) (r : ℕ) : Set (MvPolynomial (Fin n) ℝ) :=
  { p | ∃ (σ₀ : MvPolynomial (Fin n) ℝ) (σ : Fin n → MvPolynomial (Fin n) ℝ),
    IsSOS σ₀ ∧
    (∀ i, IsSOS (σ i)) ∧
    σ₀.totalDegree ≤ r ∧
    (∀ i, (σ i * BoxSemialgebraicGenerator i).totalDegree ≤ r) ∧
    p = σ₀ + ∑ i : Fin n, σ i * BoxSemialgebraicGenerator i }

open Classical in
/-- The quadratic-module Lasserre bound, with `⊥` when no lower bound is feasible. -/
noncomputable def lasserre_bound_box_qm
    (f : MvPolynomial (Fin n) ℝ) (r : ℕ) : WithBot ℝ :=
  if _h : {l : ℝ | f - C l ∈ BoxQuadraticModule n r}.Nonempty then
    ↑(sSup {l : ℝ | f - C l ∈ BoxQuadraticModule n r})
  else
    ⊥

/-- The generalized quadratic module generated by `g`, truncated at degree `r`. -/
def GenQuadraticModule {m : ℕ} (g : Fin m → MvPolynomial (Fin n) ℝ) (r : ℕ) :
    Set (MvPolynomial (Fin n) ℝ) :=
  { p | ∃ (σ₀ : MvPolynomial (Fin n) ℝ) (σ : Fin m → MvPolynomial (Fin n) ℝ),
    IsSOS σ₀ ∧
    (∀ i, IsSOS (σ i)) ∧
    σ₀.totalDegree ≤ r ∧
    (∀ i, (σ i * g i).totalDegree ≤ r) ∧
    p = σ₀ + ∑ i : Fin m, σ i * g i }

/-- The generalized preordering generated by `g`, truncated at degree `r`. -/
def GenPreordering {m : ℕ} (g : Fin m → MvPolynomial (Fin n) ℝ) (r : ℕ) :
    Set (MvPolynomial (Fin n) ℝ) :=
  { p | ∃ (σ : Finset (Fin m) → MvPolynomial (Fin n) ℝ),
    (∀ J, IsSOS (σ J)) ∧
    (∀ J, (σ J * ∏ j ∈ J, g j).totalDegree ≤ r) ∧
    p = ∑ J ∈ Finset.univ.powerset, σ J * ∏ j ∈ J, g j }

namespace KrivineStengle

variable {m : ℕ}

/-- The basic closed semialgebraic set cut out by the inequalities `g i ≥ 0`. -/
def basicClosedSet (g : Fin m → MvPolynomial (Fin n) ℝ) : Set (Fin n → ℝ) :=
  {x | ∀ i, 0 ≤ MvPolynomial.eval x (g i)}

end KrivineStengle

/-! ## General Archimedean results -/

namespace GeneralArchimedean

variable {m : ℕ}

/-- Archimedeanity in the ball-certificate form used by the quantitative proof. -/
def IsArchimedean (g : Fin m → MvPolynomial (Fin n) ℝ) : Prop :=
  ∃ R r, 0 < R ∧
    C R - ∑ i : Fin n, X i ^ 2 ∈ GenQuadraticModule g r

end GeneralArchimedean


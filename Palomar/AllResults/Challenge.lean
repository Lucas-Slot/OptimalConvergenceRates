/-! ## LICQ/CQC upper bound -/

-- Mirror `CQC/Defs.lean`.
set_option linter.hashCommand false in
#challengeResetAuxLemmas

/-- Linear independence of active constraint gradients at every feasible point. -/
def CQC {n m : ℕ} (g : Fin m → MvPolynomial (Fin n) ℝ) : Prop :=
  ∀ x ∈ KrivineStengle.basicClosedSet g,
    LinearIndependent ℝ
      (fun i : {i : Fin m // MvPolynomial.eval x (g i) = 0} ↦
        fun j : Fin n ↦ MvPolynomial.eval x (MvPolynomial.pderiv j (g i)))

-- Mirror `CQC/MainResults.lean`.
set_option linter.hashCommand false in
#challengeResetAuxLemmas

theorem putinarQuarticRate
    {n m : ℕ} (hn : 0 < n) (_hm : 0 < m)
    {g : Fin m → MvPolynomial (Fin n) ℝ}
    {p : MvPolynomial (Fin n) ℝ}
    (hne : (KrivineStengle.basicClosedSet g).Nonempty)
    (harch : GeneralArchimedean.IsArchimedean g)
    (hcqc : CQC g)
    (hp : IsNonnegOn p (KrivineStengle.basicClosedSet g)) :
    ∃ A : ℝ, ∃ r₀ : ℕ, 0 < A ∧ 0 < r₀ ∧
      ∀ r, r₀ ≤ r →
        p + C (A / (r : ℝ) ^ 4) ∈ GenQuadraticModule g r := by
  sorry

theorem putinarQuarticDegreeBound
    {n m : ℕ} (hn : 0 < n) (_hm : 0 < m)
    {g : Fin m → MvPolynomial (Fin n) ℝ}
    {p : MvPolynomial (Fin n) ℝ}
    (hne : (KrivineStengle.basicClosedSet g).Nonempty)
    (harch : GeneralArchimedean.IsArchimedean g)
    (hcqc : CQC g)
    (hp : IsNonnegOn p (KrivineStengle.basicClosedSet g)) :
    ∃ A : ℝ, ∃ r₀ : ℕ, 0 < A ∧ 0 < r₀ ∧
      ∀ epsilon : ℝ, 0 < epsilon →
        ∃ r : ℕ,
          (r : ℝ) < (r₀ : ℝ) +
              (A / epsilon) ^ ((1 : ℝ) / 4) + 1 ∧
            p + C epsilon ∈ GenQuadraticModule g r := by
  sorry

/-! ## MFCQ quadratic lower bound -/

namespace MFCQQuadraticLowerBound

/-- The coordinate `u`. -/
abbrev u : MvPolynomial (Fin 3) ℝ := X 0

/-- The coordinate `v`. -/
abbrev v : MvPolynomial (Fin 3) ℝ := X 1

/-- The coordinate `t`, which is also the objective. -/
abbrev t : MvPolynomial (Fin 3) ℝ := X 2

abbrev q₁ : MvPolynomial (Fin 3) ℝ := u ^ 2 - C 3 * v ^ 2
abbrev q₂ : MvPolynomial (Fin 3) ℝ := v ^ 2 - C 3 * u ^ 2
abbrev q₃ : MvPolynomial (Fin 3) ℝ := C 4 * u * v - u ^ 2 - v ^ 2
abbrev q₄ : MvPolynomial (Fin 3) ℝ := -C 4 * u * v - u ^ 2 - v ^ 2

/-- The redundant ball constraint that makes the module Archimedean. -/
abbrev ball : MvPolynomial (Fin 3) ℝ :=
  C 1 - u ^ 2 - v ^ 2 - t ^ 2

/-- The five generators `t-q₁`, ..., `t-q₄`, and the unit-ball generator. -/
def generators : Fin 5 → MvPolynomial (Fin 3) ℝ :=
  ![t - q₁, t - q₂, t - q₃, t - q₄, ball]

/-- The objective in the example. -/
abbrev objective : MvPolynomial (Fin 3) ℝ := t

/-- Best nonnegative perturbation admitting a paper-order `r` certificate. -/
def hierarchyError (r : ℕ) : ℝ :=
  sInf {ε : ℝ | 0 ≤ ε ∧
    objective + C ε ∈ GenQuadraticModule generators (2 * r)}

-- Mirror `MFCQQuadraticLowerBound/MainResults.lean`.
set_option linter.hashCommand false in
#challengeResetAuxLemmas

theorem certificate_lower_bound
    (r : ℕ) (hr : 1 ≤ r) (ε : ℝ)
    (hcertificate : objective + C ε ∈
      GenQuadraticModule generators (2 * r)) :
    (1 : ℝ) / (2 ^ 14 * (r : ℝ) ^ 2) < ε := by
  sorry

theorem certificate_order_lower_bound
    (r : ℕ) (hr : 1 ≤ r) (ε : ℝ) (hε : 0 < ε)
    (hcertificate : objective + C ε ∈
      GenQuadraticModule generators (2 * r)) :
    (1 : ℝ) / (128 * Real.sqrt ε) < (r : ℝ) := by
  sorry

theorem hierarchy_error_lower_bound (r : ℕ) (hr : 1 ≤ r) :
    (1 : ℝ) / (2 ^ 14 * (r : ℝ) ^ 2) ≤ hierarchyError r := by
  sorry

end MFCQQuadraticLowerBound

end OptimalConvergenceRates


namespace KrivineStengle

/-- First coordinate of the fixed three-variable Archimedean example. -/
def sharpSeedA : MvPolynomial (Fin 3) ℝ := X 0

/-- Second coordinate of the fixed three-variable Archimedean example. -/
def sharpSeedB : MvPolynomial (Fin 3) ℝ := X 1

/-- Objective coordinate of the fixed three-variable Archimedean example. -/
def sharpSeedZ : MvPolynomial (Fin 3) ℝ := X 2

/-- The nontrivial generator `z*a*b + z^5`. -/
def sharpSeedW : MvPolynomial (Fin 3) ℝ :=
  sharpSeedZ * sharpSeedA * sharpSeedB + sharpSeedZ ^ 5

/-- The four generators of the fixed three-variable Archimedean example. -/
def sharpSeedGenerators : Fin 4 → MvPolynomial (Fin 3) ℝ :=
  ![sharpSeedA, sharpSeedB, sharpSeedW,
    1 - sharpSeedA ^ 2 - sharpSeedB ^ 2 - sharpSeedZ ^ 2]

end KrivineStengle

namespace GeneralArchimedean

abbrev sharpArchimedeanZ : MvPolynomial (Fin 3) ℝ :=
  KrivineStengle.sharpSeedZ

/-- The fixed generators in the matching three-variable example. -/
abbrev sharpArchimedeanGenerators : Fin 4 → MvPolynomial (Fin 3) ℝ :=
  KrivineStengle.sharpSeedGenerators

/-- The objective `z` in the matching three-variable example. -/
abbrev sharpArchimedeanObjective : MvPolynomial (Fin 3) ℝ :=
  sharpArchimedeanZ

-- Mirror `GeneralArchimedean/MainResults.lean`.

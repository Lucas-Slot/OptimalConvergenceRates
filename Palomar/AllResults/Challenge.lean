/-! ## Putinar lower bound -/

/-- The perturbed corner polynomial `(1 - x_0^2)(1 - x_1^2) + epsilon`. -/
def f_eps (ε : ℝ) : MvPolynomial (Fin 2) ℝ :=
  (1 - X 0 ^ 2) * (1 - X 1 ^ 2) + C ε

/-- The absolute constant in the weighted vertical endpoint estimate. -/
def verticalEndpointConst : ℝ := 100 * Real.exp 12

/-- The absolute constant in the horizontal Markov-control estimate. -/
def horizontalControlConst : ℝ := 100 * Real.exp 12

/-- The positive quarter-power constant in the Putinar lower bound. -/
def improvedLowerBoundConst : ℝ :=
  min (1 / 1000000)
    (min (1 / (36 * verticalEndpointConst ^ 2))
      (1 / (36 * horizontalControlConst ^ 2)))

/-- The small-perturbation threshold for the Putinar lower bound. -/
def improvedEpsilon0 : ℝ := (improvedLowerBoundConst / 4) ^ 4

-- Mirror `LowerDegreeBoundsPutinar/MainResults.lean`.
set_option linter.hashCommand false in
#challengeResetAuxLemmas

theorem improvedLowerBoundMembershipBoxQM
    (ε : ℝ) (hε : 0 < ε) (hε0 : ε ≤ improvedEpsilon0) (r : ℕ)
    (hmem : f_eps ε ∈ BoxQuadraticModule 2 r) :
    improvedLowerBoundConst * ε ^ (-(1 : ℝ) / 4) ≤ (r : ℝ) := by
  sorry

theorem improved_lasserre_box_qm_gap
    (ε : ℝ) (hε : 0 < ε) (hε0 : ε ≤ improvedEpsilon0) (r : ℕ)
    (hr : (r : ℝ) < improvedLowerBoundConst * ε ^ (-(1 : ℝ) / 4)) :
    lasserre_bound_box_qm (f_eps ε) r < ↑ε := by
  sorry

/-! ## Choi--Lam and Motzkin lower bounds -/

-- Mirror `ExamplePolynomials/ChoiLam.lean`.
set_option linter.hashCommand false in
#challengeResetAuxLemmas

/-- The quaternary Choi--Lam quartic. -/
def choiLamQuartic : MvPolynomial (Fin 4) ℝ :=
  X 0 ^ 4 + X 1 ^ 2 * X 2 ^ 2 + X 2 ^ 2 * X 3 ^ 2 + X 3 ^ 2 * X 1 ^ 2
    - 4 * X 0 * X 1 * X 2 * X 3

/-- The Choi--Lam quartic plus the constant perturbation `epsilon`. -/
def choiLamPerturbed (epsilon : ℝ) : MvPolynomial (Fin 4) ℝ :=
  choiLamQuartic + C epsilon

-- Mirror `LowerDegreeBoundsSchmudgen/ChoiLam/Defs.lean`.
set_option linter.hashCommand false in
#challengeResetAuxLemmas

/-- The radius of the small interior box used in the Choi--Lam argument. -/
def schmInteriorS : ℝ := 1 / 4

/-- A uniform lower bound for box-preordering weights on the interior box. -/
def schmInteriorAlpha0 : ℝ := (1 - schmInteriorS ^ 2) ^ 4

/-- The smallness constant used in the weighted-jet comparison. -/
def weightedJetGamma0 : ℝ := 1 / 1000000

/-- The absolute constant in the weighted-jet coefficient error bound. -/
def jetErrorConst : ℝ := 1000000

/-- An auxiliary constant for the Choi--Lam quarter-power lower bound. -/
def schmInteriorLowerBoundConst : ℝ :=
  min weightedJetGamma0 (Real.sqrt (1 / (4 * jetErrorConst)))

/-- The small-perturbation threshold for the Choi--Lam lower bound. -/
def schmInteriorEpsilon0 : ℝ := (schmInteriorLowerBoundConst / 4) ^ 4

/-- Intentional definition hole for the separation-derived Choi--Lam constant. -/
noncomputable def schmInteriorLowerBoundConst4 : ℝ := by
  sorry

namespace Motzkin

/-- The homogeneous ternary Motzkin sextic. -/
def motzkinSextic : MvPolynomial (Fin 3) ℝ :=
  X 0 ^ 4 * X 1 ^ 2 + X 0 ^ 2 * X 1 ^ 4 + X 2 ^ 6
    - 3 * X 0 ^ 2 * X 1 ^ 2 * X 2 ^ 2

/-- The Motzkin sextic plus the constant perturbation `epsilon`. -/
def motzkinPerturbed (epsilon : ℝ) : MvPolynomial (Fin 3) ℝ :=
  motzkinSextic + C epsilon

/-- Intentional definition hole for the separation-derived Motzkin constant. -/
noncomputable def motzkinLowerBoundConst : ℝ := by
  sorry

/-- The small-perturbation threshold for the Motzkin lower bound. -/
noncomputable def motzkinEpsilon0 : ℝ := (1 / 16 : ℝ) ^ 6

end Motzkin


#challengeResetAuxLemmas

theorem generalArchimedeanUpperRate :
    ∀ {n m : ℕ} (g : Fin m → MvPolynomial (Fin n) ℝ)
        (p : MvPolynomial (Fin n) ℝ),
      (KrivineStengle.basicClosedSet g).Nonempty →
      IsArchimedean g →
      IsNonnegOn p (KrivineStengle.basicClosedSet g) →
      ∃ C₀ r₀, 0 < C₀ ∧ 0 < r₀ ∧
        ∀ r, r₀ ≤ r →
          p + C (C₀ * (Real.log ((max r 2 : ℕ) : ℝ) ^ 4 / (r : ℝ) ^ 2)) ∈
            GenQuadraticModule g r := by
  sorry

theorem generalArchimedeanEpsilonCertificate :
    ∀ {n m : ℕ} (g : Fin m → MvPolynomial (Fin n) ℝ)
        (p : MvPolynomial (Fin n) ℝ),
      (KrivineStengle.basicClosedSet g).Nonempty →
      IsArchimedean g →
      IsNonnegOn p (KrivineStengle.basicClosedSet g) →
      ∃ D K : ℝ, 0 ≤ D ∧ 0 ≤ K ∧
        ∀ {epsilon : ℝ}, 0 < epsilon → epsilon ≤ 1 →
          p + C epsilon ∈ GenQuadraticModule g
            (Nat.ceil (D + K / Real.sqrt epsilon *
              (1 + Real.log epsilon⁻¹) ^ 2)) := by
  sorry

theorem sharpArchimedeanRate :
    ∃ c C₀ r₀, 0 < c ∧ 0 < C₀ ∧ 0 < r₀ ∧
      ∀ r, r₀ ≤ r →
        sharpArchimedeanObjective +
            C (C₀ * (Real.log ((max r 2 : ℕ) : ℝ) ^ 4 / (r : ℝ) ^ 2)) ∈
            GenQuadraticModule sharpArchimedeanGenerators r ∧
          ∀ ε, 0 ≤ ε →
            sharpArchimedeanObjective + C ε ∈
                GenQuadraticModule sharpArchimedeanGenerators r →
              c * (Real.log ((max r 2 : ℕ) : ℝ) ^ 4 / (r : ℝ) ^ 2) ≤ ε := by
  sorry

theorem sharpArchimedeanDegreeLowerBound :
    ∃ c epsilon₀ : ℝ, 0 < c ∧ 0 < epsilon₀ ∧
      ∀ epsilon : ℝ, 0 < epsilon → epsilon ≤ epsilon₀ →
        ∀ r : ℕ,
          sharpArchimedeanObjective + C epsilon ∈
              GenQuadraticModule sharpArchimedeanGenerators r →
            c * Real.log epsilon⁻¹ ^ 2 / Real.sqrt epsilon ≤ (r : ℝ) := by
  sorry

end GeneralArchimedean

/-! ## General compact results -/

namespace GeneralCompact

/-- First coordinate in the fixed bivariate compact example. -/
def sharpA : MvPolynomial (Fin 2) ℝ := X 0

/-- Objective coordinate in the fixed bivariate compact example. -/
def sharpZ : MvPolynomial (Fin 2) ℝ := X 1

/-- Cubic generator of the fixed bivariate compact example. -/
def sharpH : MvPolynomial (Fin 2) ℝ :=
  sharpZ * (sharpA ^ 2 + sharpZ ^ 2)

/-- Unit-ball generator of the fixed bivariate compact example. -/
def sharpBall : MvPolynomial (Fin 2) ℝ :=
  1 - sharpA ^ 2 - sharpZ ^ 2

/-- The two generators of the fixed bivariate compact example. -/
def sharpGenerators : Fin 2 → MvPolynomial (Fin 2) ℝ :=
  ![sharpH, sharpBall]

/-- The linear objective of the fixed bivariate compact example. -/
def sharpObjective : MvPolynomial (Fin 2) ℝ := sharpZ

-- Mirror `GeneralCompact/MainResults.lean`.
